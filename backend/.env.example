SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db_volume/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BASE_URL=http://127.0.0.1:8000/
FRONTEND_URL=http://localhost:3000

USE_S3_MEDIA=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-redpandaacademy-bucket
AWS_S3_REGION_NAME=eu-west-1

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Red Panda Academy <no-reply@redpandaacademy.local>

GOOGLE_WEB_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=com.example.redpandaacademy

